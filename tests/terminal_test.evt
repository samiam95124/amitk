# Events for the automatic run of terminal_test: see doc/auto_events.md.
# The same file serves terminal_testc, the same test on the console library.

# The devices of the run: the real keyboard, mouse and joystick are set aside,
# and the test is told of one joystick of six axes and eight buttons, and one
# mouse of three buttons, whatever is on the desk
keyboardoff
mouseoff
joystickoff
joysticknum 1
joyaxis 6
joybutton 8
mousenum 1
mousebutton 3

# Joystick test: joystick 1 runs each axis through its range, then asserts
# and releases each of its buttons
sync 38
joymov 1 -max -max -max -max -max -max
joymov 1 -max/2 -max/2 -max/2 -max/2 -max/2 -max/2
joymov 1 0 0 0 0 0 0
joymov 1 max/2 max/2 max/2 max/2 max/2 max/2
joymov 1 max max max max max max
joyba 1 1
joybd 1 1
joyba 1 2
joybd 1 2
joyba 1 3
joybd 1 3
joyba 1 4
joybd 1 4
joyba 1 5
joybd 1 5
joyba 1 6
joybd 1 6
joyba 1 7
joybd 1 7
joyba 1 8
joybd 1 8
enter

# Mouse test: mouse 1 visits the corners of the screen, then walks a box
# around the middle where the marker shows whole, then presses and releases
# each of its buttons
sync 39
moumov 1 1 1
moumov 1 80 1
moumov 1 80 22
moumov 1 1 22
moumov 1 20 6
moumov 1 40 6
moumov 1 60 6
moumov 1 60 12
moumov 1 60 18
moumov 1 40 18
moumov 1 20 18
moumov 1 20 12
moumov 1 40 12
mouba 1 1
moubd 1 1
mouba 1 2
moubd 1 2
mouba 1 3
moubd 1 3
enter
