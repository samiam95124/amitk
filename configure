#!/usr/bin/env bash
################################################################################
#
# Configure script for Petit-Ami
#
# Checks that the tools and the development packages the build needs are on
# the machine, and installs the packages that are missing. The required set is
# what the default "make" target links against; the optional set is what the
# regression tests and the manual build use. Both are installed: a required
# package that fails to install stops the configure, an optional one is
# reported and the configure goes on.
#
# Options:
#
# --check   Report what is missing and install nothing.
# --ask     Ask before each package is installed (Y/n). A required package
#           that is declined leaves the configure incomplete.
# --help    Print this.
#
################################################################################

check="0"
ask="0"
for var in "$@"
do

    case "$var" in

    --check) check="1" ;;
    --ask)   ask="1" ;;
    --help)

        echo "Configure program for Petit-Ami"
        echo
        echo "configure [--check] [--ask]"
        echo
        echo "Checks for the tools and development packages the build needs and"
        echo "installs the missing packages. --check reports and installs nothing."
        echo "--ask asks before each package is installed (Y/n)."
        exit 0
        ;;

    *)

        echo "*** Option not recognized: $var"
        echo "Terminating"
        exit 1
        ;;

    esac

done

################################################################################
#
# Routines
#

#
# Check command exists
#
# Uses the bash "command" built in. Adds the name to the missing tools list.
#
function checkexists {

    if ! command -v "$1" >/dev/null 2>&1 ; then

        echo "*** No $1 was found"
        missingtools="$missingtools $1"

    fi

}

#
# Check a package is installed, by the host's package manager. Adds the name
# to the list given (required or optional) when it is not.
#
function checkpkg {

    case "$host" in

    linux)

        if dpkg -s "$1" 2>/dev/null | grep -q '^Status: .* installed' ; then return 0; fi
        ;;

    bsd)

        if pkg info -e "$1" 2>/dev/null ; then return 0; fi
        ;;

    mac)

        if [ -n "$brew" ] && "$brew" list --versions "$1" >/dev/null 2>&1 ; then return 0; fi
        ;;

    esac
    return 1

}

#
# Pick the packages to install from a list of missing ones. With --ask each is
# put to the user, and return alone, or anything but an n, takes it; without,
# all are taken. The result is in the variable picked. No answer to be had,
# the input being at its end, declines.
#
function pickpkgs {

    local p ans

    picked=""
    for p in "$@"
    do

        if [ "$ask" = "1" ]
        then

            ans="n"
            read -r -p "Install $p? (Y/n) " ans
            case "$ans" in
            [nN]*) echo "    $p not installed" ;;
            *)     picked="$picked $p" ;;
            esac

        else picked="$picked $p"
        fi

    done

}

################################################################################
#
# Set default variables
#
if [ "$(uname)" = "Linux" ]
then

    compiler="gcc"
    bits="64"
    host="linux"

elif [ "$(uname)" = "FreeBSD" ]
then

    compiler="clang"
    bits="64"
    host="bsd"

elif [ "$(uname)" = "Darwin" ]
then

    compiler="clang"
    bits="64"
    host="mac"

    #
    # Packages come from Homebrew. The Makefile finds them through
    # /opt/homebrew/bin/brew, so look there when brew is not on the path.
    #
    brew="$(command -v brew)"
    if [ -z "$brew" ] && [ -x /opt/homebrew/bin/brew ] ; then brew="/opt/homebrew/bin/brew"; fi

else

    echo "*** Supported operating system not found"
    exit 1

fi

################################################################################
#
# The packages the build needs.
#
# Required: what the default make target compiles and links against. Each is
# the development package, carrying the headers and the link library.
#
# Optional: what the regression tests and the manual use. The terminal tests
# run in an xterm on a private Xvfb; doc/mkpdf renders the manual with
# LibreOffice. The ssh tests run a private sshd of their own, on a port of
# their own, and want only the program: Linux has it in openssh-server, which
# also turns the system's ssh service on, so that is turned off again when it
# is this script that installed the package. FreeBSD and the Mac carry sshd
# in the base system.
#
if [ "$host" = "linux" ]
then

    required="build-essential pkgconf
              libssl-dev
              libasound2-dev libfluidsynth-dev
              libpng-dev zlib1g-dev
              libfreetype-dev libfontconfig-dev
              libx11-dev libxext-dev libxtst-dev
              libwayland-dev libxkbcommon-dev"
    optional="xvfb xterm openssh-server libreoffice-writer"

elif [ "$host" = "bsd" ]
then

    required="gmake pkgconf
              openssl
              alsa-lib fluidsynth
              png
              freetype2 fontconfig
              libX11 libXext libXtst
              wayland libxkbcommon"
    optional="xorg-vfbserver xterm libreoffice"

elif [ "$host" = "mac" ]
then

    # The rest of the build is the system frameworks, from Xcode
    required="openssl@3 freetype"
    optional=""

fi

################################################################################
#
# Find what is missing
#
missingreq=""
missingopt=""
missingtools=""

for p in $required
do

    if ! checkpkg "$p" ; then missingreq="$missingreq $p"; fi

done

for p in $optional
do

    if ! checkpkg "$p" ; then missingopt="$missingopt $p"; fi

done

################################################################################
#
# Install the required packages that are missing, or say what they are
#
if [ -n "$missingreq" ]
then

    echo "Required packages not installed:$missingreq"
    if [ "$check" = "1" ]
    then

        echo "Install them with:"
        if [ "$host" = "linux" ] ; then echo "    sudo apt-get install$missingreq"
        elif [ "$host" = "mac" ] ; then echo "    brew install$missingreq"
        else echo "    sudo pkg install$missingreq"
        fi

    elif pickpkgs $missingreq && [ "$picked" != "$missingreq" ] && declined="1" && [ -z "$picked" ]
    then

        # every one of them was declined: nothing to install
        true

    elif [ "$host" = "linux" ]
    then

        sudo apt-get install -y $picked || installfailed="1"

    elif [ "$host" = "mac" ]
    then

        #
        # Homebrew installs as the user, never with sudo
        #
        if [ -z "$brew" ]
        then

            echo "*** Homebrew was not found. Install it from https://brew.sh, then"
            echo "    run configure again."
            exit 1

        fi
        "$brew" install $picked || installfailed="1"

    else

        sudo pkg install -y $picked || installfailed="1"

    fi

    if [ "$installfailed" = "1" ]
    then

        echo "*** Aborting: the package install failed"
        exit 1

    fi

else

    echo "All required packages are installed"

fi

if [ -n "$missingopt" ]
then

    echo "Optional packages not installed (tests and manual):$missingopt"
    if [ "$check" = "1" ]
    then

        echo "Install them with:"
        if [ "$host" = "linux" ] ; then echo "    sudo apt-get install$missingopt"
        elif [ "$host" = "mac" ] ; then echo "    brew install$missingopt"
        else echo "    sudo pkg install$missingopt"
        fi

    else

        #
        # The build stands without these, so a failure here is said and
        # passed: the tests that want them skip, and say so.
        #
        optfailed="0"
        pickpkgs $missingopt
        if [ -z "$picked" ] ; then true
        elif [ "$host" = "linux" ] ; then sudo apt-get install -y $picked || optfailed="1"
        elif [ "$host" = "mac" ] ; then

            if [ -n "$brew" ] ; then "$brew" install $picked || optfailed="1"
            else optfailed="1"
            fi

        else sudo pkg install -y $picked || optfailed="1"
        fi
        #
        # The ssh server was wanted for its program, not its service: a
        # machine that did not take remote logins before does not now. One
        # that had the package already is left as it was.
        #
        case " $picked " in
        *" openssh-server "*)

            if [ "$host" = "linux" ] && checkpkg openssh-server
            then

                echo "Turning the system ssh service off: the tests run their own"
                sudo systemctl disable --now ssh.socket ssh.service

            fi
            ;;

        esac
        if [ "$optfailed" = "1" ]
        then

            echo "*** The optional package install failed: the tests that need"
            echo "    them will be skipped, and the manual will not build"

        fi

    fi

else

    echo "All optional packages are installed"

fi

################################################################################
#
# Determine if needed programs exist. The only fatal one is the C compiler,
# because we need that to compile Petit-Ami. The rest will impact the running
# of various test and build scripts.
#
checkexists grep
checkexists diff
checkexists sed
checkexists rm
checkexists cp
checkexists mv
checkexists ls
checkexists tar
checkexists make
checkexists ar
if [ "$host" != "mac" ] ; then checkexists pkg-config; fi

#
# Fail on no C compiler found
#
if ! command -v "$compiler" >/dev/null 2>&1 ; then

    echo "*** Aborting: cannot complete without known C compiler ($compiler)"
    exit 1

fi

if [ -n "$missingreq" ] && [ "$check" = "1" ]
then

    echo "Configure found missing packages"
    exit 1

fi

if [ "$declined" = "1" ]
then

    echo "Configure is incomplete: required packages were declined"
    exit 1

fi

echo "Configure completed!"
